# Copy to .env and fill in. Never commit .env.

# --- External services (required) ---
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Jina Reader key, used by the scraper (https://jina.ai/reader)
JINA_API_KEY=
# HireMeTech auth token (localStorage 'auth_token'), used by the resolver
HIRE_ME_TECH_TOKEN=

# --- Database ---
# Option A (cloud: Neon / Supabase): a single connection string. Takes precedence over PG_*.
#   e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Option B (local Postgres without Docker):
PG_USER=
PG_PASSWORD=
PG_DB=
PG_HOST=localhost
PG_PORT=5432
# Note: docker compose ignores both and uses its own db container.

# --- Optional ---
# Gemini model ID (default: gemini-2.5-flash-lite)
GEMINI_MODEL=
# true = save resolver debug screenshots to $LOG_DIR/debug
DEBUG_SCREENSHOTS=false
# Base directory for logs / debug output (default: ./logs)
LOG_DIR=

# --- Tests only ---
# Disposable database for pytest. Its name MUST contain "test": the tests drop the whole schema.
TEST_DATABASE_URL=
