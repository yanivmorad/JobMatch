# Copy to .env and fill in. Never commit .env.

# --- External services (required) ---
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Jina Reader key, used by the scraper (https://jina.ai/reader)
JINA_API_KEY=
# HireMeTech auth token (localStorage 'auth_token'), used by the resolver
HIRE_ME_TECH_TOKEN=

# --- Database ---
# Option A (cloud: Neon / Supabase): a single connection string. Takes precedence over PG_*.
#   e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Option B (local Postgres without Docker):
PG_USER=
PG_PASSWORD=
PG_DB=
PG_HOST=localhost
PG_PORT=5432
# Note: docker compose ignores both and uses its own db container.

# --- Security (required in the cloud) ---
# Shared secret for the API: every /api/* request needs "Authorization: Bearer <API_TOKEN>".
# Leave empty only for local development. The dashboard asks for it once and keeps it in the
# browser. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Allowed browser origins for the API (comma separated). Default "*" (auth is the header token).
CORS_ORIGINS=

# --- Profile (resume + personal context) ---
# Stored in the DB (table "profile") and edited in the Profile tab. On first run it is seeded from,
# in order: these env vars, the *_FILE paths, Render secret files
# (/etc/secrets/resume.txt, /etc/secrets/personal_context.txt), then data/resume.txt and
# "data/Personal Context.txt".
RESUME_TEXT=
RESUME_FILE=
PERSONAL_CONTEXT_TEXT=
PERSONAL_CONTEXT_FILE=

# --- WhatsApp bot (optional: all five, or the bot is off) ---
# Setup steps: docs/whatsapp-setup.md. Meta app: developers.facebook.com -> your app -> WhatsApp.
# Any string you choose; type the same value as "Verify token" in WhatsApp -> Configuration.
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret (checks the X-Hub-Signature-256 of every webhook).
WHATSAPP_APP_SECRET=
# A System User access token (the temporary token in API Setup expires within hours).
WHATSAPP_ACCESS_TOKEN=
# API Setup -> "Phone number ID" (the id, not the phone number).
WHATSAPP_PHONE_NUMBER_ID=
# Who may use the bot, comma separated, country code first: 972501234567. Others get no answer.
WHATSAPP_ALLOWED_NUMBERS=
# Graph API version for sending (default v27.0).
WHATSAPP_GRAPH_VERSION=

# --- Optional ---
# false = no browser at all (saves ~300MB RAM): no Playwright fallback in the scraper, and
# HireMeTech links are analyzed from their public page. Default true.
ENABLE_PLAYWRIGHT=
# Gemini models. Default: the chain gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3-flash-preview
# The free daily quota is per model (measured 2026-11-22: 20 requests/day for
# gemini-2.5-flash-lite), so when one model hits it the AI worker moves to the next and
# returns to the first after the reset. Scores of different models are not directly
# comparable - each analysis stores the model that produced it.
# GEMINI_MODEL = use only this model. GEMINI_MODELS = your own chain (overrides GEMINI_MODEL).
GEMINI_MODEL=
GEMINI_MODELS=
# Gemini rate limit (free tier). The per-model free limits are shown only in AI Studio
# (https://aistudio.google.com/rate-limit) - check yours and set these to match.
# GEMINI_RPM: requests per minute (default 10). GEMINI_RPD: requests per day, counted per
# Pacific-time day like Google's quota (default 0 = no local cap; a daily 429 from Gemini
# still pauses the AI worker until midnight Pacific).
GEMINI_RPM=
GEMINI_RPD=
# Job description sent to the AI is cleaned and cut to this many characters (default 8000)
MAX_DESCRIPTION_CHARS=
# Automatic retries for transient failures (timeouts, 5xx, crash mid-job) before FAILED_* (default 3)
MAX_JOB_ATTEMPTS=
# Longest idle wait between queue checks when there is no work, in seconds (default 60).
# New jobs wake the workers immediately; this only paces the background polling.
IDLE_POLL_MAX_SECONDS=
# true = save resolver debug screenshots to $LOG_DIR/debug
DEBUG_SCREENSHOTS=false
# Base directory for logs / debug output (default: ./logs)
LOG_DIR=

# --- Tests only ---
# Disposable database for pytest. Its name MUST contain "test": the tests drop the whole schema.
# With the compose db (docker compose up -d db; then once:
#   docker compose exec db createdb -U jobmatch jobmatch_test):
#   TEST_DATABASE_URL=postgresql://jobmatch:jobmatch@127.0.0.1:5434/jobmatch_test
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and every
# connection waits for that to fail (the DB tests took ~10x longer).
TEST_DATABASE_URL=
