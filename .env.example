# Copy this file to .env (in the project root) and fill in the values.

# --- AI analysis (required) ---
GEMINI_API_KEY=

# --- Scraping (recommended; without it Jina is rate-limited and Playwright is used as fallback) ---
JINA_API_KEY=

# --- HireMeTech link resolution (optional; only needed for hiremetech.com links) ---
HIRE_ME_TECH_TOKEN=

# --- PostgreSQL (required) ---
PG_USER=postgres
PG_PASSWORD=
PG_DB=jobmatch
PG_HOST=localhost
PG_PORT=5432
